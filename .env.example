# ============================================================
# VoxRadar · Kwai Collector · A1_Radar
# ============================================================

# --- Navegador -------------------------------------------------
# Executar navegador sem interface gráfica (útil em CI/servidor).
# Valores aceitos: true | false
# Padrão: false
KWAI_HEADLESS=false

# --- Timeouts (em milissegundos) -------------------------------
# Timeout padrão para navegação (page.goto).
# Padrão: 30000 (30s)
KWAI_GOTO_TIMEOUT=30000

# Tempo de espera após carregar a página, antes de capturar
# o tráfego de rede / SSR.
# Padrão: 6000 (6s)
KWAI_WAIT_AFTER_LOAD=6000

# Tempo de espera entre rolagens de página (paginação).
# Padrão: 2000 (2s)
KWAI_SCROLL_WAIT=2000

# --- User-Agent ------------------------------------------------
# User-Agent usado pelo Chromium do Playwright.
# Deixe em branco para usar o padrão do Playwright.
KWAI_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# --- Limites (defaults da CLI) ---------------------------------
# Podem ser sobrescritos via --limit na linha de comando.
KWAI_DEFAULT_LIMIT_BUSCA=50
KWAI_DEFAULT_LIMIT_USUARIO=100

# --- Diretório de saída ----------------------------------------
# Diretório base onde os JSONs são salvos quando --out é relativo.
KWAI_OUTPUT_DIR=out

# --- Logs ------------------------------------------------------
# Nível de verbosidade: DEBUG | INFO | WARNING | ERROR
KWAI_LOG_LEVEL=INFO
