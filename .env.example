# Copie para .env se quiser mudar algo. Todos têm valor padrão.

# segundos entre um request e outro
KWAI_REQUEST_DELAY=1.5

# timeout de cada request (segundos)
KWAI_HTTP_TIMEOUT=20

# quantas vezes tenta de novo em falha passageira (rede, 429, 5xx)
KWAI_MAX_RETRIES=3

# user agent da busca; deixe comentado para usar o padrão
# KWAI_USER_AGENT=
