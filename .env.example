# Copie para .env e ajuste conforme necessário. NÃO commite o .env.

# Intervalo mínimo (segundos) entre requisições — respeita o rate limit do Kwai.
KWAI_REQUEST_DELAY=1.5

# Timeout de cada requisição HTTP (segundos).
KWAI_HTTP_TIMEOUT=20

# Tentativas extras em falhas transitórias (retry com backoff exponencial).
KWAI_MAX_RETRIES=3

# User-Agent enviado nas requisições web (busca e perfil; comentários usam o UA do app).
# Deixe comentado para usar o padrão embutido; descomente apenas para sobrescrevê-lo.
# KWAI_USER_AGENT=
