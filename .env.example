# Configuração opcional; a CLI funciona sem copiar este arquivo.
# A1_Radar

# Intervalo entre páginas e posts da coleta mobile (segundos).
KWAI_MOBILE_PAGE_DELAY=2

# Tentativas e backoff para falhas transitórias.
KWAI_MAX_TENTATIVAS=3
KWAI_BACKOFF_BASE=1

# Intervalo das consultas de perfil e busca (segundos).
KWAI_DELAY=2
